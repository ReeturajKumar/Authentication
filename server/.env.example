# Copy to server/.env and adjust. Never commit the real .env.
NODE_ENV=development

# Bind to localhost only. Change deliberately if the HMI must be reachable on a plant LAN.
HOST=127.0.0.1
PORT=4000

# Local MongoDB only. Use a least-privilege account (readWrite on scada_auth), e.g.:
# MONGODB_URI=mongodb://scada_app:CHANGE_ME@127.0.0.1:27017/scada_auth?authSource=scada_auth&directConnection=true
MONGODB_URI=mongodb://127.0.0.1:27017/scada_auth?directConnection=true

# bcrypt work factor (>= 12 enforced in production).
BCRYPT_ROUNDS=12

SESSION_TTL_MINUTES=480
RESTRICTED_SESSION_TTL_MINUTES=15

# true when served over HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# Origins allowed to make state-changing requests (Vite dev server + built app).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000

LOGIN_RATE_LIMIT=20
API_RATE_LIMIT=600
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Accounts created by `npm run setup-admin` and `npm run seed`. Plaintext lives only here (.env is gitignored);
# the database stores bcrypt hashes. The employee must change this password at first sign-in.
ADMIN_EMAIL=admin@scada.local
ADMIN_PASSWORD=CHANGE_ME-Admin-Pass-1!
EMPLOYEE_EMAIL=employee@scada.local
EMPLOYEE_PASSWORD=CHANGE_ME-Employee-Pass-1!
