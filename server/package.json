{
  "name": "scada-auth-demo-server",
  "version": "1.0.0",
  "private": true,
  "description": "Offline SCADA authentication demo - backend (modular monolith)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:local": "node scripts/local-mongod.js",
    "setup-admin": "node scripts/setup-admin.js",
    "seed": "node scripts/seed-demo-employee.js",
    "test": "jest --runInBand"
  },
  "engines": { "node": ">=20.12" },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/env.js"],
    "testTimeout": 60000
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1"
  }
}
